DATABASE_URL="postgresql://user:password@localhost:5432/deutsch_lernen?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=8000

CORS_ORIGINS="http://localhost:5173"

# Production (no Render): point DATABASE_URL at Supabase's *Transaction
# pooler* URI (port 6543, user postgres.<project-ref>). SSL is detected
# automatically. Copy JWT_SECRET from the old host so existing app logins
# keep working.
#
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # Project Settings -> API (never the anon key)
# SUPABASE_STORAGE_BUCKET="uploads"

# First admin account, created on first boot if it doesn't exist yet.
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
