DATABASE_URL="postgresql://user:password@localhost:5432/deutsch_lernen?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=8000

CORS_ORIGINS="http://localhost:5173"

# Production (no Render): point DATABASE_URL at Supabase's *Transaction
# pooler* URI (port 6543, user postgres.<project-ref>). SSL is detected
# automatically. Copy JWT_SECRET from the old host so existing app logins
# keep working.
#
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # Project Settings -> API (never the anon key)
# SUPABASE_STORAGE_BUCKET="uploads"

# Optional: push notifications (Firebase Cloud Messaging). Without these,
# sending is a safe no-op — Notification rows are still written, nothing is
# delivered. Get the JSON key from Firebase Console -> Project Settings ->
# Service Accounts, base64 it as one line (e.g. `base64 -w0 key.json` on
# Linux/macOS, `[Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))`
# in PowerShell) — raw JSON isn't safe here because Cloud Run's env-var
# format is comma-delimited and a key file's commas would get corrupted.
#
# FIREBASE_PROJECT_ID="project-id"
# FIREBASE_SERVICE_ACCOUNT_JSON_B64="eyJ0eXBl..."

# First admin account, created on first boot if it doesn't exist yet.
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
