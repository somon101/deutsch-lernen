<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for all network access (API calls, media/library file
         picking, TTS voice downloads) — without it Android blocks every
         socket-level connection at the OS level regardless of URL or
         server health, which is exactly what was masking as a login
         failure no matter which backend address was tried. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Сделать фото" in the avatar picker (settings screen) — Android only,
         image_picker has no Windows desktop implementation so that option
         doesn't exist there. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ requires this declared for the runtime notification
         permission prompt (triggered by FirebaseMessaging.requestPermission
         in push_service.dart) to do anything at all — without it, push
         notifications silently never show on those devices. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the locally-scheduled study reminder survive a real device
         reboot, not just an app restart (§ study reminder local delivery,
         2026-09-15) — without this, Android clears every app's exact
         alarms on boot and nothing reschedules them until the app happens
         to be opened again. RECEIVE_BOOT_COMPLETED is the permission;
         ScheduledNotificationBootReceiver (bundled with
         flutter_local_notifications, no custom native code needed) is the
         receiver that re-registers the schedule at boot from what the
         plugin already persisted on-device. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="deutsch_lernen"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Re-registers scheduled local notifications (the study
             reminder) after a device reboot — see the
             RECEIVE_BOOT_COMPLETED permission comment above. Bundled with
             the flutter_local_notifications plugin itself. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
