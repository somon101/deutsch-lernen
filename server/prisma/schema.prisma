generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

// Structured account + progress data only. Lesson content itself (video,
// audio, vocabulary, text) stays file-based under /lessonN — this table only
// ever references a lessonId string, never the material itself.
model User {
  id             String     @id @default(uuid())
  // 9-digit public-facing identifier shown in the UI (profile, personal
  // details, QR card) instead of the internal `id` above. `id` stays the
  // primary key — every relation/route already depends on it — this is
  // purely a second, cosmetic identifier. Added nullable, backfilled onto
  // every existing row, then set NOT NULL — see the two
  // add_public_id_nullable / public_id_not_null migrations. Every code
  // path that creates a User must set it explicitly.
  publicId       String     @unique
  firstName      String
  lastName       String
  email          String     @unique
  phone          String?
  username       String     @unique
  // Lower-cased copy of `username`, kept in sync on every write. The unique
  // constraint lives here so "Ivan" and "ivan" cannot both exist — enforced
  // by the database, not just by validation. `username` keeps the original
  // casing for display.
  usernameLower  String     @unique
  passwordHash   String
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  avatarUrl      String?
  // Free-text "about me" shown on the profile screen — capped at 150 chars,
  // enforced app-side (Pydantic/UI), not by a DB column length constraint.
  bio            String?
  birthDate      DateTime?
  canEditProfile Boolean    @default(true)
  // Timestamp of the most recent successful login — a denormalized copy of
  // the newest LoginEvent below, kept here too so the admin user list can
  // show it without joining/aggregating per row.
  lastLoginAt    DateTime?
  // Updated (throttled, see requireAuth) on every authenticated request, not
  // just login — this is what "online" is computed from, since a user can
  // stay signed in and keep using the app for a long time after their last
  // actual login.
  lastActiveAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  attempts     LessonAttempt[]
  lessonStates LessonState[]
  loginEvents  LoginEvent[]
  answerLogs   AnswerLog[]
  pushTokens   PushToken[]
}

/// One row per successful login, so an admin can see a user's full login
/// history (date and time of each), not just the most recent one.
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Live "where the user is inside a lesson" state — the stage-by-stage
// progress that used to live in the browser's localStorage. Server-side and
// user-scoped, so it follows the account across devices/browsers.
model LessonState {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String

  completedStages String[] @default([])
  vocabIndex      Int      @default(0)

  miniTestCorrect Int?
  miniTestTotal   Int?
  miniTestAt      DateTime?
  practiceCorrect Int?
  practiceTotal   Int?
  practiceAt      DateTime?
  reviewCorrect   Int?
  reviewTotal     Int?
  reviewAt        DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
}

// One row per completed pass through a lesson (recorded when the user
// finishes the "review" stage). Best/last/attempt-count are derived by
// querying this table, not stored redundantly, so the server is always the
// single source of truth for scoring.
model LessonAttempt {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String

  miniTestCorrect Int
  miniTestTotal   Int
  practiceCorrect Int
  practiceTotal   Int
  reviewCorrect   Int
  reviewTotal     Int
  score           Int

  createdAt DateTime @default(now())

  @@index([userId, lessonId])
}

// ---------------------------------------------------------------------------
// Admin-editable course content.
//
// Lesson material still ships as files under /lessonN and stays the default
// source. These tables are an override layer: a lesson only appears here once
// an admin has edited it, and until then the app behaves exactly as before.
// ---------------------------------------------------------------------------

model LessonContent {
  lessonId     String   @id
  // The lesson text in the same plain format as the source file, parsed by
  // the very same client-side parser. Null means "no override" — same
  // meaning as videoUrl/audioUrl below, so a row can exist to carry just a
  // media override without forcing an (empty-string) material override too.
  materialText String?
  // Overrides for the bundled lesson video/audio file. Null means "use the
  // file that ships in the lesson folder".
  videoUrl     String?
  audioUrl     String?
  updatedAt    DateTime @updatedAt
  updatedById  String?
}

model VocabularyItem {
  id            String  @id @default(uuid())
  lessonId      String
  german        String
  translation   String
  pronunciation String?
  // Recorded pronunciation uploaded by an admin. Null means the app falls
  // back to the browser's speech synthesis for this word.
  audioUrl      String?
  position      Int
  // Case- and punctuation-insensitive form of `german`. The unique constraint
  // lives here so the same word cannot be entered into two different lessons
  // of the SAME course — enforced by the database, not only by validation.
  // Different courses are independent and may each use the same word.
  germanKey     String
  // "legacy" for the original file-based course; a Course id for built ones.
  courseId      String  @default("legacy")

  @@unique([courseId, germanKey])
  @@index([lessonId, position])
}

model LessonQuestion {
  id            String   @id @default(uuid())
  lessonId      String
  // Which stage's set this belongs to: "minitest" | "practice" | "review".
  setName       String
  prompt        String
  options       String[]
  // Stored by value rather than index, so reordering options in the editor
  // can never silently change which answer is correct.
  correctAnswer String
  position      Int
  courseId      String   @default("legacy")
  // Which named block inside the stage this question belongs to. Null for the
  // original file-based course, which has a single unnamed set per stage.
  blockId       String?
  // "choice" | "truefalse" | "cloze" | "scramble" | "match". Every row ever
  // written before this column existed is a plain multiple-choice question,
  // so the default backfills them correctly with no migration of data.
  kind          String   @default("choice")
  // Only "match" questions use this — an array of { left, right } pairs. The
  // other kinds fit entirely into prompt/options/correctAnswer above.
  data          Json?

  @@index([lessonId, setName, position])
  @@index([blockId, position])
}

// ---------------------------------------------------------------------------
// Course builder.
//
// The original course is the set of /lessonN folders on disk and is untouched
// by these tables. Courses created in the builder live entirely here, are
// independent of each other, and never copy from one another.
// ---------------------------------------------------------------------------

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String       @default("")
  coverUrl    String?
  status      CourseStatus @default(DRAFT)
  position    Int
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  // Nullable during the migration window (add nullable -> backfill -> set
  // NOT NULL, same pattern as User.publicId earlier). The legacy file-based
  // course (lessonN folders, courseId "legacy") has no Course row at all and
  // is deliberately exempt from the language/level dimension — see the
  // approved migration plan.
  levelId     String?
  level       Level?       @relation(fields: [levelId], references: [id], onDelete: Restrict)

  lessons CourseLesson[]
}

// ---------------------------------------------------------------------------
// Language / Level / Topic — content taxonomy layered on top of the existing
// Course/CourseLesson tree. Schema-ready for multiple languages (per the
// approved plan), but only "de" is seeded/populated for now — adding a real
// second language is a deliberately separate future step, not part of this
// change.
// ---------------------------------------------------------------------------

model Language {
  id   String @id // ISO-639-1-style short code (e.g. "de") — the code IS the id.
  name String

  levels Level[]
  topics Topic[]
}

model Level {
  id         String   @id @default(uuid())
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict)
  code       String // e.g. "A1" — unique per language, not globally (A1 exists once per language).
  name       String
  position   Int // display/progress-aggregation order: A1 < A2 < B1 < ...

  courses Course[]

  @@unique([languageId, code])
}

/// A knowledge/topic tag (e.g. "Präteritum") that different Materials across
/// different lessons can share, so weak-spot detection can point at a
/// specific piece of knowledge rather than "redo the whole lesson".
model Topic {
  id         String   @id @default(uuid())
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict)
  name       String
  createdAt  DateTime @default(now())

  materials Material[]
  questions Question[]

  @@index([languageId])
}

// ---------------------------------------------------------------------------
// Material / MaterialBlock — a lesson's teaching content as real, addressable
// objects, replacing the flat CourseLesson.materialText/videoUrl/audioUrl
// fields going forward (those old fields are kept, unused, as a safe
// rollback/reference — see the migration plan's backfill step). One lesson
// can have several Materials (theory text, a video, an audio track, ...),
// each independently taggable with a Topic. A text Material is itself made
// of ordered MaterialBlocks (the teacher-authored "Что такое Präteritum?"
// style chunks) — this is intentionally a SEPARATE model from LessonBlock
// below, which groups QUESTIONS inside a minitest/practice/review stage and
// means something different despite the similar name.
// ---------------------------------------------------------------------------

model Material {
  id           String   @id @default(uuid())
  // Loose references, matching the existing LessonBlock/LessonQuestion
  // convention (no DB-level FK to Course/CourseLesson): "legacy" for the
  // file-based course, else a real Course.id; lessonId is CourseLesson.id
  // for builder courses, or the "lessonN" folder slug for legacy.
  courseId     String
  lessonId     String
  // "text" | "video" | "audio" | "grammar" | "other" — free-text, not an
  // enum, same convention as LessonBlock.stage/LessonQuestion.kind.
  materialType String
  title        String
  topicId      String?
  topic        Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blocks MaterialBlock[]

  @@index([lessonId, position])
}

model MaterialBlock {
  id         String   @id @default(uuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  title      String
  content    String
  position   Int

  placements QuestionPlacement[]

  @@index([materialId, position])
}

model CourseLesson {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title        String
  description  String  @default("")
  // Same plain/Markdown lesson text the existing parser already understands.
  materialText String  @default("")
  videoUrl     String?
  audioUrl     String?
  position     Int

  @@index([courseId, position])
}

/// A named group of questions inside one stage of a built lesson, so a stage
/// can hold several blocks ("Мини-тест 1", "Мини-тест 2") while the learner
/// still passes through the same stage sequence as before.
model LessonBlock {
  id       String @id @default(uuid())
  courseId String
  lessonId String
  /// Which stage the block belongs to: "minitest" | "practice" | "review".
  stage    String
  title    String
  position Int

  @@index([lessonId, stage, position])
}

// ---------------------------------------------------------------------------
// Reusable question pool + per-question answer history.
//
// LessonQuestion (above) is untouched and keeps working exactly as before —
// every existing row and every existing read/write path against it stays
// valid. Question/QuestionPlacement is the new, parallel path going forward:
// a Question is a standalone, reusable object (a stable question_id); a
// QuestionPlacement says WHERE it's used (a MaterialBlock's theory quiz, or
// an existing LessonBlock's minitest/practice/review stage) — one Question
// can have many Placements, which is what makes reuse a real reference
// instead of a copy. The existing 109 LessonQuestion rows are copied into
// this shape by the migration's backfill step, not deleted.
// ---------------------------------------------------------------------------

model Question {
  id            String   @id @default(uuid())
  // "choice" | "truefalse" | "cloze" | "scramble" | "match" — same 5 kinds
  // LessonQuestion already uses.
  kind          String   @default("choice")
  prompt        String
  options       String[]
  correctAnswer String
  // Only "match" questions use this — same convention as LessonQuestion.data.
  data          Json?
  topicId       String?
  topic         Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  placements QuestionPlacement[]

  @@index([topicId])
}

model QuestionPlacement {
  id              String         @id @default(uuid())
  questionId      String
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Exactly ONE of these three is set on any given row — a placement lives
  // in a Material's theory block, an existing LessonBlock's quiz stage, or
  // (for the legacy file-based course, which has neither) a bare
  // lessonId+setName pair, mirroring LessonQuestion's own
  // lessonId/setName/blockId split for that course. lessonBlockId/
  // legacyLessonId/legacySetName are loose references (same convention as
  // LessonQuestion.blockId), not DB-level FKs.
  materialBlockId String?
  materialBlock   MaterialBlock? @relation(fields: [materialBlockId], references: [id], onDelete: Cascade)
  lessonBlockId   String?
  legacyLessonId  String?
  legacySetName   String?
  position        Int

  @@index([materialBlockId, position])
  @@index([lessonBlockId, position])
  @@index([legacyLessonId, legacySetName, position])
  @@index([questionId])
}

/// One row per answered question — the real, per-question source of truth
/// that lesson/level/overall progress and weak-spot detection are computed
/// from. LessonAttempt/LessonState (above) are left untouched and keep being
/// written exactly as before for backward compatibility; nothing here
/// replaces them, this is purely additive.
model AnswerLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Loose reference, no FK (2026-08-26 — extended to cover quiz answers
  // too): either a Question.id (reusable pool question, attached to a
  // MaterialBlock) or a LessonQuestion.id (old quiz system — minitest/
  // practice/review). The two id spaces are disjoint UUIDs, so this is safe;
  // see submit_answer() for the validation that accepts either.
  questionId    String
  // Which QuestionPlacement the user actually answered it through — nullable
  // since a question can in principle be answered standalone (e.g. a future
  // "review your weak spots" flow not tied to a specific lesson placement).
  placementId   String?
  answerData    Json
  correct       Boolean
  attemptNumber Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([userId, questionId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Push notifications — a generic mechanism, not tied to any one event.
// `Notification.type` identifies which event produced it ("lesson_created"
// is the only one wired up today); a future event type reuses these same
// three tables and the same send path, no new system needed. Purely
// additive — no existing table's columns change.
// ---------------------------------------------------------------------------

/// One row per device a user has granted notification permission on (a user
/// can have several — phone + another phone, reinstall, etc.). `token` is
/// the FCM registration token; unique because a token is never meaningfully
/// shared between rows, and re-registering the same token just updates it.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  // "android" | "ios" | "web" — free-text, same convention as
  // LessonBlock.stage / LessonQuestion.kind, so a future platform needs no
  // migration.
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A log of every notification actually sent (or attempted), and the record
/// the manual "Отправить уведомление" button re-sends from if needed.
/// courseId/lessonId are the same loose, no-FK convention as
/// Material/LessonBlock — this event's deep-link target, not a hard
/// dependency.
model Notification {
  id          String   @id @default(uuid())
  type        String
  title       String
  body        String
  deepLink    String?
  courseId    String?
  lessonId    String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

/// Single-row table (id is always "singleton") holding the admin-facing
/// on/off switches for automatic sending. One boolean per event type, so a
/// future event adds one column here rather than a new table.
model NotificationSettings {
  id                  String   @id @default("singleton")
  autoSendOnNewLesson Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}
